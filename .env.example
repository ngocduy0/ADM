NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Default false để tránh CHANNEL_ERROR khi Supabase Realtime chưa bật cho database tables.
NEXT_PUBLIC_ENABLE_SUPABASE_REALTIME=true

# Production security: add this from Supabase Project Settings > API.
# Never expose this value in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=admin@duyt.vn
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Performance tuning (server only)
# Maximum duration for a Supabase request before returning a controlled error.
SUPABASE_REQUEST_TIMEOUT_MS=5000
# Short server cache for the combined concierge read model.
CONCIERGE_READ_CACHE_TTL_MS=3000
# Session lifetime in seconds (default: 4 hours).
ADMIN_SESSION_MAX_AGE_SECONDS=14400

# Public production origin used by Declarative Web Push deep links.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Web Push for iPhone/iPad PWA. Generate once with:
# npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Cloudinary (server only) - Dashboard > API Keys
# API_SECRET must never use NEXT_PUBLIC_ prefix or be exposed in client code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
